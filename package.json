{
  "name": "yo8aiu-cmc-chat-function",
  "description": "Cloud Function care face conexiunea securizata intre site-ul yo8aiu.ro si API-ul de AI (Gemini) pentru chatbot-ul cmc.",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions:cmcChat",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-functions": "^6.0.1",
    "firebase-admin": "^12.6.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
